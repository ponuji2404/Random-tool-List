            function resetAll() {
                state.file1 = { workbook: null, fileName: '', sheetNames: [], activeSheet: '', headers: [], rows: [] };
                state.file2 = { workbook: null, fileName: '', sheetNames: [], activeSheet: '', headers: [], rows: [] };
                state.config.selectedSecondaryCols.clear();
                state.config.columnSearchFilter = '';
                dom.colSearchInput.value = '';
                dom.fileInput1.value = '';
                dom.fileInput2.value = '';
                dom.resetAllBtn.classList.add('hidden');

                updateFileCardUI(1);
                updateFileCardUI(2);
                onFilesUpdated();
                showToast('Workspace reset.', 'info');
            }

            // =========================================================================
            // DRAG & DROP + EVENT LISTENERS
            // =========================================================================
            function setupDropZone(dropZoneEl, fileInputEl, fileIndex) {
                ['dragenter', 'dragover'].forEach((evtName) => {
                    dropZoneEl.addEventListener(evtName, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        dropZoneEl.classList.add('drop-zone-active');
                    });
                });

                ['dragleave', 'drop'].forEach((evtName) => {
                    dropZoneEl.addEventListener(evtName, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        dropZoneEl.classList.remove('drop-zone-active');
                    });
                });

                dropZoneEl.addEventListener('drop', (e) => {
                    const files = e.dataTransfer?.files;
                    if (files && files.length > 0) {
                        handleFileUpload(files[0], fileIndex);
                    }
                });

                fileInputEl.addEventListener('change', (e) => {
                    if (e.target.files && e.target.files.length > 0) {
                        handleFileUpload(e.target.files[0], fileIndex);
                    }
                });
            }

            setupDropZone(dom.dropZone1, dom.fileInput1, 1);
            setupDropZone(dom.dropZone2, dom.fileInput2, 2);

            dom.replaceFile1Btn.addEventListener('click', () => dom.fileInput1.click());
            dom.replaceFile2Btn.addEventListener('click', () => dom.fileInput2.click());

            dom.sheetSelect1.addEventListener('change', (e) => switchActiveSheet(1, e.target.value));
            dom.sheetSelect2.addEventListener('change', (e) => switchActiveSheet(2, e.target.value));

            dom.loadSampleBtn.addEventListener('click', loadSampleData);
            dom.emptyStateSampleBtn.addEventListener('click', loadSampleData);
            dom.resetAllBtn.addEventListener('click', resetAll);

            dom.primaryKeySelect.addEventListener('change', (e) => {
                state.config.primaryKey = e.target.value;
                executeMergeAndRender();
            });

            dom.secondaryKeySelect.addEventListener('change', (e) => {
                const oldKey = state.config.secondaryKey;
                const newKey = e.target.value;
                state.config.secondaryKey = newKey;

                // Automatically uncheck the newly chosen join key (and re-check old key if desired)
                state.config.selectedSecondaryCols.delete(newKey);
                if (oldKey && oldKey !== newKey) {
                    state.config.selectedSecondaryCols.add(oldKey);
                }

                renderSecondaryChecklist();
                executeMergeAndRender();
            });

            dom.caseInsensitiveCheck.addEventListener('change', (e) => {
                state.config.caseInsensitive = e.target.checked;
                executeMergeAndRender();
            });

            dom.trimWhitespaceCheck.addEventListener('change', (e) => {
                state.config.trimWhitespace = e.target.checked;
                executeMergeAndRender();
            });

            dom.joinTypeRadios.forEach((radio) => {
                radio.addEventListener('change', (e) => {
                    state.config.joinType = e.target.value;
                    executeMergeAndRender();
                });
            });

            dom.selectAllColsBtn.addEventListener('click', () => {
                state.file2.headers.forEach((col) => state.config.selectedSecondaryCols.add(col));
                renderSecondaryChecklist();
                executeMergeAndRender();
            });

            dom.deselectAllColsBtn.addEventListener('click', () => {
                state.config.selectedSecondaryCols.clear();
                renderSecondaryChecklist();
                executeMergeAndRender();
            });

            dom.colSearchInput.addEventListener('input', (e) => {
                state.config.columnSearchFilter = e.target.value;
                renderSecondaryChecklist();
            });

            dom.downloadExcelBtn.addEventListener('click', downloadMergedWorkbook);
        })();
    </script>
</body>
