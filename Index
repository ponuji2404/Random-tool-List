    <!-- Application Logic -->
    <script>
        (function () {
            'use strict';

            // =========================================================================
            // APPLICATION STATE
            // =========================================================================
            const state = {
                file1: {
                    workbook: null,
                    fileName: '',
                    sheetNames: [],
                    activeSheet: '',
                    headers: [],
                    rows: []
                },
                file2: {
                    workbook: null,
                    fileName: '',
                    sheetNames: [],
                    activeSheet: '',
                    headers: [],
                    rows: []
                },
                config: {
                    primaryKey: '',
                    secondaryKey: '',
                    caseInsensitive: true,
                    trimWhitespace: true,
                    joinType: 'left', // 'left' | 'inner'
                    selectedSecondaryCols: new Set(),
                    columnSearchFilter: ''
                },
                mergedResult: {
                    headers: [], // Array of { key, label, isMerged, originalName }
                    rows: [],    // Array of plain objects keyed by output column header
                    stats: {
                        totalPrimary: 0,
                        matched: 0,
                        unmatched: 0,
                        totalCols: 0,
                        addedCols: 0
                    }
                }
            };

            // =========================================================================
            // DOM ELEMENTS CACHE
            // =========================================================================
            const dom = {
                loadSampleBtn: document.getElementById('loadSampleBtn'),
                emptyStateSampleBtn: document.getElementById('emptyStateSampleBtn'),
                resetAllBtn: document.getElementById('resetAllBtn'),
                toastContainer: document.getElementById('toastContainer'),

                // File 1
                dropZone1: document.getElementById('dropZone1'),
                fileInput1: document.getElementById('fileInput1'),
                fileInfo1: document.getElementById('fileInfo1'),
                fileName1: document.getElementById('fileName1'),
                fileStats1: document.getElementById('fileStats1'),
                sheetSelect1: document.getElementById('sheetSelect1'),
                replaceFile1Btn: document.getElementById('replaceFile1Btn'),

                // File 2
                dropZone2: document.getElementById('dropZone2'),
                fileInput2: document.getElementById('fileInput2'),
                fileInfo2: document.getElementById('fileInfo2'),
                fileName2: document.getElementById('fileName2'),
                fileStats2: document.getElementById('fileStats2'),
                sheetSelect2: document.getElementById('sheetSelect2'),
                replaceFile2Btn: document.getElementById('replaceFile2Btn'),

                // Sections
                emptyStatePrompt: document.getElementById('emptyStatePrompt'),
                step2Section: document.getElementById('step2Section'),
                step3Section: document.getElementById('step3Section'),

                // Step 2 Config
                autoMatchBadge: document.getElementById('autoMatchBadge'),
                primaryKeySelect: document.getElementById('primaryKeySelect'),
                secondaryKeySelect: document.getElementById('secondaryKeySelect'),
                caseInsensitiveCheck: document.getElementById('caseInsensitiveCheck'),
                trimWhitespaceCheck: document.getElementById('trimWhitespaceCheck'),
                joinTypeRadios: document.querySelectorAll('input[name="joinType"]'),
                selectAllColsBtn: document.getElementById('selectAllColsBtn'),
                deselectAllColsBtn: document.getElementById('deselectAllColsBtn'),
                colSearchInput: document.getElementById('colSearchInput'),
                selectedColsCountBadge: document.getElementById('selectedColsCountBadge'),
                secondaryColsChecklist: document.getElementById('secondaryColsChecklist'),
                renameNotice: document.getElementById('renameNotice'),

                // Step 3 Preview & Export
                outputFileNameInput: document.getElementById('outputFileNameInput'),
                downloadExcelBtn: document.getElementById('downloadExcelBtn'),
                statTotalPrimary: document.getElementById('statTotalPrimary'),
                statMatchedRows: document.getElementById('statMatchedRows'),
                statMatchRate: document.getElementById('statMatchRate'),
                statUnmatchedRows: document.getElementById('statUnmatchedRows'),
                statTotalCols: document.getElementById('statTotalCols'),
                statAddedColsBadge: document.getElementById('statAddedColsBadge'),
                previewRowLimitLabel: document.getElementById('previewRowLimitLabel'),
                previewTableHead: document.getElementById('previewTableHead'),
                previewTableBody: document.getElementById('previewTableBody')
            };

            // =========================================================================
            // TOAST NOTIFICATION SYSTEM (No alert())
            // =========================================================================
            function showToast(message, type = 'info') {
                const toast = document.createElement('div');
                const styles = {
                    info: 'bg-slate-900 text-white border-slate-700',
                    success: 'bg-emerald-900 text-white border-emerald-700',
                    error: 'bg-rose-900 text-white border-rose-700'
                };
                toast.className = `pointer-events-auto px-4 py-3 rounded-xl border shadow-lg text-xs sm:text-sm font-medium flex items-center justify-between gap-3 animate-fade-in ${styles[type] || styles.info}`;
                
                const textSpan = document.createElement('span');
                textSpan.textContent = message;
                toast.appendChild(textSpan);

                const closeBtn = document.createElement('button');
                closeBtn.innerHTML = '&times;';
                closeBtn.className = 'text-lg leading-none opacity-70 hover:opacity-100 cursor-pointer';
                closeBtn.onclick = () => toast.remove();
                toast.appendChild(closeBtn);

                dom.toastContainer.appendChild(toast);
                setTimeout(() => {
                    if (toast.parentNode) toast.remove();
                }, 4200);
            }

            // =========================================================================
            // EXCEL PARSING & WORKBOOK HELPERS
            // =========================================================================
            function parseSheetData(workbook, sheetName) {
                const worksheet = workbook.Sheets[sheetName];
                if (!worksheet) return { headers: [], rows: [] };

                // Convert sheet to 2D array first so we can cleanly extract & deduplicate headers
                const rawMatrix = XLSX.utils.sheet_to_json(worksheet, { header: 1, defval: '' });
                if (!rawMatrix || rawMatrix.length === 0) {
                    return { headers: [], rows: [] };
                }

                // Extract headers from first non-empty row
                const rawHeaders = rawMatrix[0].map((cell, idx) => {
                    const str = String(cell ?? '').trim();
                    return str || `Column_${idx + 1}`;
                });

                // Ensure unique header names within the same sheet
                const seenHeaders = new Map();
                const headers = rawHeaders.map((h) => {
                    if (!seenHeaders.has(h)) {
                        seenHeaders.set(h, 1);
                        return h;
                    }
                    const count = seenHeaders.get(h) + 1;
                    seenHeaders.set(h, count);
                    return `${h}_${count}`;
                });

                // Build row objects
                const rows = [];
                for (let r = 1; r < rawMatrix.length; r++) {
                    const rowArr = rawMatrix[r];
                    // Skip completely blank trailing rows
                    const isEmptyRow = rowArr.every((val) => val === '' || val === null || val === undefined);
                    if (isEmptyRow) continue;

                    const rowObj = {};
                    headers.forEach((header, colIdx) => {
                        rowObj[header] = rowArr[colIdx] !== undefined ? rowArr[colIdx] : '';
                    });
                    rows.push(rowObj);
                }

                return { headers, rows };
            }

            function handleFileUpload(file, fileIndex) {
                if (!file) return;
                const validExtensions = ['.xlsx', '.xls', '.csv'];
                const lowerName = file.name.toLowerCase();
                if (!validExtensions.some((ext) => lowerName.endsWith(ext))) {
                    showToast('Please upload a valid .xlsx, .xls, or .csv file.', 'error');
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (e) {
                    try {
                        const data = new Uint8Array(e.target.result);
                        const workbook = XLSX.read(data, { type: 'array' });

                        if (!workbook.SheetNames || workbook.SheetNames.length === 0) {
                            showToast('The uploaded workbook contains no sheets.', 'error');
                            return;
                        }

                        const targetState = fileIndex === 1 ? state.file1 : state.file2;
                        targetState.workbook = workbook;
                        targetState.fileName = file.name;
                        targetState.sheetNames = workbook.SheetNames;
                        targetState.activeSheet = workbook.SheetNames[0];

                        const parsed = parseSheetData(workbook, targetState.activeSheet);
                        targetState.headers = parsed.headers;
                        targetState.rows = parsed.rows;

                        if (targetState.headers.length === 0) {
                            showToast(`Sheet "${targetState.activeSheet}" appears to be empty.`, 'error');
                        } else {
                            showToast(`Loaded "${file.name}" (${parsed.rows.length} rows)`, 'success');
                        }

                        updateFileCardUI(fileIndex);
                        onFilesUpdated();
                    } catch (err) {
                        console.error(err);
                        showToast('Failed to parse spreadsheet. Ensure the file is not password-protected or corrupted.', 'error');
                    }
                };
                reader.readAsArrayBuffer(file);
            }

            function switchActiveSheet(fileIndex, newSheetName) {
                const targetState = fileIndex === 1 ? state.file1 : state.file2;
                if (!targetState.workbook) return;

                targetState.activeSheet = newSheetName;
                const parsed = parseSheetData(targetState.workbook, newSheetName);
                targetState.headers = parsed.headers;
                targetState.rows = parsed.rows;

                updateFileCardUI(fileIndex);
                onFilesUpdated();
            }

            function updateFileCardUI(fileIndex) {
                const targetState = fileIndex === 1 ? state.file1 : state.file2;
                const dropZone = fileIndex === 1 ? dom.dropZone1 : dom.dropZone2;
                const fileInfo = fileIndex === 1 ? dom.fileInfo1 : dom.fileInfo2;
                const fileNameEl = fileIndex === 1 ? dom.fileName1 : dom.fileName2;
                const fileStatsEl = fileIndex === 1 ? dom.fileStats1 : dom.fileStats2;
                const sheetSelect = fileIndex === 1 ? dom.sheetSelect1 : dom.sheetSelect2;

                if (!targetState.workbook) {
                    dropZone.classList.remove('hidden');
                    fileInfo.classList.add('hidden');
                    return;
                }

                dropZone.classList.add('hidden');
                fileInfo.classList.remove('hidden');
                dom.resetAllBtn.classList.remove('hidden');

                fileNameEl.textContent = targetState.fileName;
                fileStatsEl.textContent = `${targetState.rows.length.toLocaleString()} rows • ${targetState.headers.length} columns`;

                // Populate sheet selector
                sheetSelect.innerHTML = '';
                targetState.sheetNames.forEach((name) => {
                    const opt = document.createElement('option');
                    opt.value = name;
                    opt.textContent = name;
                    if (name === targetState.activeSheet) opt.selected = true;
                    sheetSelect.appendChild(opt);
                });
            }

            // =========================================================================
            // CONFIGURATION & AUTO-MATCHING LOGIC
            // =========================================================================
            function onFilesUpdated() {
                const bothLoaded = state.file1.workbook !== null && state.file2.workbook !== null;

                if (!bothLoaded) {
                    dom.emptyStatePrompt.classList.remove('hidden');
                    dom.step2Section.classList.add('hidden');
                    dom.step3Section.classList.add('hidden');
                    return;
                }

                dom.emptyStatePrompt.classList.add('hidden');
                dom.step2Section.classList.remove('hidden');
                dom.step3Section.classList.remove('hidden');

                // Set default output filename based on primary file
                const baseName = state.file1.fileName.replace(/\.[^/.]+$/, '');
                dom.outputFileNameInput.value = `${baseName}_merged`;

                populateKeySelectors();
                initializeSecondaryColumnsSelection();
                renderSecondaryChecklist();
                executeMergeAndRender();
            }

            function populateKeySelectors() {
                const h1 = state.file1.headers;
                const h2 = state.file2.headers;

                // Attempt smart auto-match on column names (case-insensitive)
                let matchedPrimary = '';
                let matchedSecondary = '';
                let autoMatched = false;

                for (const col1 of h1) {
                    const found = h2.find((col2) => col2.trim().toLowerCase() === col1.trim().toLowerCase());
                    if (found) {
                        matchedPrimary = col1;
                        matchedSecondary = found;
                        autoMatched = true;
                        break;
                    }
                }

                state.config.primaryKey = matchedPrimary || h1[0] || '';
                state.config.secondaryKey = matchedSecondary || h2[0] || '';

                if (autoMatched) {
                    dom.autoMatchBadge.classList.remove('hidden');
                } else {
                    dom.autoMatchBadge.classList.add('hidden');
                }

                // Populate Primary Key dropdown
                dom.primaryKeySelect.innerHTML = '';
                h1.forEach((col) => {
                    const opt = document.createElement('option');
                    opt.value = col;
                    opt.textContent = col;
                    if (col === state.config.primaryKey) opt.selected = true;
                    dom.primaryKeySelect.appendChild(opt);
                });

                // Populate Secondary Key dropdown
                dom.secondaryKeySelect.innerHTML = '';
                h2.forEach((col) => {
                    const opt = document.createElement('option');
                    opt.value = col;
                    opt.textContent = col;
                    if (col === state.config.secondaryKey) opt.selected = true;
                    dom.secondaryKeySelect.appendChild(opt);
                });
            }

            function initializeSecondaryColumnsSelection() {
                // By default, select all secondary columns EXCEPT the join key column itself
                state.config.selectedSecondaryCols.clear();
                state.file2.headers.forEach((col) => {
                    if (col !== state.config.secondaryKey) {
                        state.config.selectedSecondaryCols.add(col);
                    }
                });
            }

            function getOutputColumnName(secCol, primaryHeadersSet) {
                if (!primaryHeadersSet.has(secCol)) {
                    return { finalName: secCol, wasRenamed: false };
                }
                let candidate = `${secCol}_merged`;
                let counter = 2;
                while (primaryHeadersSet.has(candidate)) {
                    candidate = `${secCol}_merged_${counter}`;
                    counter++;
                }
                return { finalName: candidate, wasRenamed: true };
            }

            function renderSecondaryChecklist() {
                const h2 = state.file2.headers;
                const primarySet = new Set(state.file1.headers);
                const filter = state.config.columnSearchFilter.trim().toLowerCase();

                dom.secondaryColsChecklist.innerHTML = '';
                let hasAnyRename = false;
                let visibleCount = 0;

                h2.forEach((col) => {
                    if (filter && !col.toLowerCase().includes(filter)) return;
                    visibleCount++;

                    const isChecked = state.config.selectedSecondaryCols.has(col);
                    const isJoinKey = col === state.config.secondaryKey;
                    const { finalName, wasRenamed } = getOutputColumnName(col, primarySet);
                    if (isChecked && wasRenamed) hasAnyRename = true;

                    const label = document.createElement('label');
                    label.className = 'flex items-center justify-between gap-3 px-4 py-2.5 hover:bg-slate-50 cursor-pointer transition select-none';

                    const leftDiv = document.createElement('div');
                    leftDiv.className = 'flex items-center gap-3 min-w-0';

                    const checkbox = document.createElement('input');
                    checkbox.type = 'checkbox';
                    checkbox.checked = isChecked;
                    checkbox.className = 'w-4 h-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500 shrink-0';
                    checkbox.addEventListener('change', () => {
                        if (checkbox.checked) {
                            state.config.selectedSecondaryCols.add(col);
                        } else {
                            state.config.selectedSecondaryCols.delete(col);
                        }
                        renderSecondaryChecklist();
                        executeMergeAndRender();
                    });

                    const nameSpan = document.createElement('span');
                    nameSpan.className = 'text-xs sm:text-sm font-medium text-slate-800 truncate';
                    nameSpan.textContent = col;

                    leftDiv.appendChild(checkbox);
                    leftDiv.appendChild(nameSpan);

                    // Badges on the right
                    const badgesDiv = document.createElement('div');
                    badgesDiv.className = 'flex items-center gap-1.5 shrink-0';

                    if (isJoinKey) {
                        const keyBadge = document.createElement('span');
                        keyBadge.className = 'text-[11px] font-medium bg-slate-100 text-slate-600 border border-slate-200 px-2 py-0.5 rounded-full';
                        keyBadge.textContent = 'Join Key';
                        badgesDiv.appendChild(keyBadge);
                    }

                    if (wasRenamed) {
                        const renameBadge = document.createElement('span');
                        renameBadge.className = 'text-[11px] font-mono font-medium bg-amber-50 text-amber-700 border border-amber-200 px-2 py-0.5 rounded-full';
                        renameBadge.title = `Column "${col}" already exists in Primary file. Will be added as "${finalName}".`;
                        renameBadge.textContent = `→ ${finalName}`;
                        badgesDiv.appendChild(renameBadge);
                    }

                    label.appendChild(leftDiv);
                    label.appendChild(badgesDiv);
                    dom.secondaryColsChecklist.appendChild(label);
                });

                if (visibleCount === 0) {
                    const emptyMsg = document.createElement('div');
                    emptyMsg.className = 'p-6 text-center text-xs text-slate-400';
                    emptyMsg.textContent = 'No columns match your filter.';
                    dom.secondaryColsChecklist.appendChild(emptyMsg);
                }

                // Update count badge & duplicate notice
                const count = state.config.selectedSecondaryCols.size;
                dom.selectedColsCountBadge.textContent = `${count} of ${h2.length} selected`;

                if (hasAnyRename) {
                    dom.renameNotice.classList.remove('hidden');
                } else {
                    dom.renameNotice.classList.add('hidden');
                }
            }

            // =========================================================================
            // CORE MERGE ENGINE (VLOOKUP / RELATIONAL JOIN)
            // =========================================================================
            function normalizeKey(rawVal) {
                if (rawVal === null || rawVal === undefined) return '';
                let str = String(rawVal);
                if (state.config.trimWhitespace) str = str.trim();
                if (state.config.caseInsensitive) str = str.toLowerCase();
                return str;
            }

            function executeMergeAndRender() {
                const pRows = state.file1.rows;
                const sRows = state.file2.rows;
                const pKeyCol = state.config.primaryKey;
                const sKeyCol = state.config.secondaryKey;

                // 1. Build lookup Map from Secondary File (first match wins, standard VLOOKUP)
                const lookupMap = new Map();
                for (let i = 0; i < sRows.length; i++) {
                    const row = sRows[i];
                    const normKey = normalizeKey(row[sKeyCol]);
                    if (normKey !== '' && !lookupMap.has(normKey)) {
                        lookupMap.set(normKey, row);
                    }
                }

                // 2. Determine output columns metadata (preserve secondary file column order)
                const primaryHeaders = state.file1.headers;
                const usedNamesSet = new Set(primaryHeaders);
                const outputColumns = primaryHeaders.map((h) => ({
                    sourceCol: h,
                    outputName: h,
                    isMerged: false
                }));

                const selectedOrdered = state.file2.headers.filter((col) =>
                    state.config.selectedSecondaryCols.has(col)
                );

                selectedOrdered.forEach((secCol) => {
                    const { finalName } = getOutputColumnName(secCol, usedNamesSet);
                    usedNamesSet.add(finalName);
                    outputColumns.push({
                        sourceCol: secCol,
                        outputName: finalName,
                        isMerged: true
                    });
                });

                // 3. Perform Join across Primary Rows
                const mergedRows = [];
                let matchedCount = 0;
                let unmatchedCount = 0;

                for (let i = 0; i < pRows.length; i++) {
                    const pRow = pRows[i];
                    const normKey = normalizeKey(pRow[pKeyCol]);
                    const matchedSecRow = normKey !== '' ? lookupMap.get(normKey) : undefined;
                    const isMatch = matchedSecRow !== undefined;

                    if (isMatch) {
                        matchedCount++;
                    } else {
                        unmatchedCount++;
                    }

                    // If Inner Join, skip unmatched rows
                    if (state.config.joinType === 'inner' && !isMatch) {
                        continue;
                    }

                    const outRow = {};
                    // Copy primary fields
                    for (let c = 0; c < primaryHeaders.length; c++) {
                        const colName = primaryHeaders[c];
                        outRow[colName] = pRow[colName] !== undefined ? pRow[colName] : '';
                    }
                    // Append selected secondary fields
                    for (let c = primaryHeaders.length; c < outputColumns.length; c++) {
                        const colMeta = outputColumns[c];
                        outRow[colMeta.outputName] = isMatch && matchedSecRow[colMeta.sourceCol] !== undefined
                            ? matchedSecRow[colMeta.sourceCol]
                            : '';
                    }

                    mergedRows.push(outRow);
                }

                // Save state
                state.mergedResult.headers = outputColumns;
                state.mergedResult.rows = mergedRows;
                state.mergedResult.stats = {
                    totalPrimary: pRows.length,
                    matched: matchedCount,
                    unmatched: unmatchedCount,
                    totalCols: outputColumns.length,
                    addedCols: selectedOrdered.length
                };

                renderSummaryAndPreview();
            }

            function renderSummaryAndPreview() {
                const { headers, rows, stats } = state.mergedResult;

                // Update summary stats
                dom.statTotalPrimary.textContent = stats.totalPrimary.toLocaleString();
                dom.statMatchedRows.textContent = stats.matched.toLocaleString();
                const rate = stats.totalPrimary > 0 ? Math.round((stats.matched / stats.totalPrimary) * 100) : 0;
                dom.statMatchRate.textContent = `${rate}%`;
                dom.statUnmatchedRows.textContent = stats.unmatched.toLocaleString();
                dom.statTotalCols.textContent = stats.totalCols.toLocaleString();
                dom.statAddedColsBadge.textContent = `+${stats.addedCols} added`;

                // Render Table Header
                dom.previewTableHead.innerHTML = '';
                const headTr = document.createElement('tr');

                // Row # index column
                const idxTh = document.createElement('th');
                idxTh.className = 'px-3 py-2.5 bg-slate-100 text-slate-500 font-mono font-medium border-b border-r border-slate-200 w-12 text-center';
                idxTh.textContent = '#';
                headTr.appendChild(idxTh);

                headers.forEach((colMeta) => {
                    const th = document.createElement('th');
                    if (colMeta.isMerged) {
                        th.className = 'px-3.5 py-2.5 bg-brand-50 text-brand-900 font-semibold border-b border-r border-brand-200 whitespace-nowrap';
                        th.innerHTML = `
                            <div class="flex items-center gap-1.5">
                                <span>${escapeHtml(colMeta.outputName)}</span>
                                <span class="text-[10px] uppercase tracking-wider font-bold bg-brand-600 text-white px-1.5 py-0.2 rounded">Added</span>
                            </div>
                        `;
                    } else {
                        const isKey = colMeta.outputName === state.config.primaryKey;
                        th.className = 'px-3.5 py-2.5 bg-slate-100 text-slate-700 font-semibold border-b border-r border-slate-200 whitespace-nowrap';
                        th.innerHTML = isKey
                            ? `<div class="flex items-center gap-1.5"><span>${escapeHtml(colMeta.outputName)}</span><span class="text-[10px] font-medium bg-slate-200 text-slate-700 px-1.5 py-0.2 rounded">Key</span></div>`
                            : escapeHtml(colMeta.outputName);
                    }
                    headTr.appendChild(th);
                });
                dom.previewTableHead.appendChild(headTr);

                // Render First 25 Rows
                const previewLimit = 25;
                const slice = rows.slice(0, previewLimit);
                dom.previewRowLimitLabel.textContent = rows.length > previewLimit
                    ? `Showing first ${previewLimit} of ${rows.length.toLocaleString()} output rows`
                    : `Showing all ${rows.length.toLocaleString()} output rows`;

                dom.previewTableBody.innerHTML = '';

                if (slice.length === 0) {
                    const emptyTr = document.createElement('tr');
                    const emptyTd = document.createElement('td');
                    emptyTd.colSpan = headers.length + 1;
                    emptyTd.className = 'px-6 py-10 text-center text-sm text-slate-500';
                    emptyTd.textContent = 'No rows matched your current Join configuration. Try switching to Left Join or enabling Case-Insensitive matching.';
                    emptyTr.appendChild(emptyTd);
                    dom.previewTableBody.appendChild(emptyTr);
                    return;
                }

                slice.forEach((rowObj, idx) => {
                    const tr = document.createElement('tr');
                    tr.className = 'hover:bg-slate-50/90 transition-colors';

                    const idxTd = document.createElement('td');
                    idxTd.className = 'px-3 py-2 bg-slate-50/60 text-slate-400 font-mono text-center border-r border-slate-200';
                    idxTd.textContent = idx + 1;
                    tr.appendChild(idxTd);

                    headers.forEach((colMeta) => {
                        const td = document.createElement('td');
                        const val = rowObj[colMeta.outputName];
                        const isEmpty = val === '' || val === null || val === undefined;

                        if (colMeta.isMerged) {
                            td.className = `px-3.5 py-2 border-r border-slate-200 whitespace-nowrap max-w-[260px] truncate ${isEmpty ? 'bg-amber-50/30 text-slate-400 italic' : 'bg-brand-50/25 text-slate-900 font-medium'}`;
                            td.textContent = isEmpty ? '—' : String(val);
                        } else {
                            td.className = 'px-3.5 py-2 border-r border-slate-200 text-slate-700 whitespace-nowrap max-w-[260px] truncate';
                            td.textContent = isEmpty ? '' : String(val);
                        }
                        td.title = isEmpty ? '' : String(val);
                        tr.appendChild(td);
                    });

                    dom.previewTableBody.appendChild(tr);
                });
            }

            function escapeHtml(str) {
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            }

            // =========================================================================
            // EXPORT TO EXCEL (.XLSX)
            // =========================================================================
            function downloadMergedWorkbook() {
                const { headers, rows } = state.mergedResult;
                if (!headers.length) {
                    showToast('Nothing to export yet.', 'error');
                    return;
                }

                try {
                    const headerNames = headers.map((h) => h.outputName);
                    // Build 2D array to preserve exact column order
                    const aoa = [headerNames];
                    for (let i = 0; i < rows.length; i++) {
                        const r = rows[i];
                        aoa.push(headerNames.map((col) => (r[col] !== undefined ? r[col] : '')));
                    }

                    const ws = XLSX.utils.aoa_to_sheet(aoa);

                    // Auto-size columns gently for better readability in Excel
                    ws['!cols'] = headerNames.map((h) => ({
                        wch: Math.min(Math.max(String(h).length + 5, 14), 36)
                    }));

                    const wb = XLSX.utils.book_new();
                    XLSX.utils.book_append_sheet(wb, ws, 'Merged_Data');

                    let rawName = dom.outputFileNameInput.value.trim() || 'merged_output';
                    rawName = rawName.replace(/\.xlsx$/i, '');
                    const finalFileName = `${rawName}.xlsx`;

                    XLSX.writeFile(wb, finalFileName);
                    showToast(`Downloaded "${finalFileName}" (${rows.length.toLocaleString()} rows)`, 'success');
                } catch (err) {
                    console.error(err);
                    showToast('Error generating Excel file.', 'error');
                }
            }

            // =========================================================================
            // SAMPLE DATA GENERATOR (For Instant Testing)
            // =========================================================================
            function loadSampleData() {
                // Sample Primary File: Sales Orders
                const primaryData = [
                    ['Order_ID', 'Customer_ID', 'Order_Date', 'Product_SKU', 'Quantity', 'Status'],
                    ['ORD-1001', 'CUST-01', '2026-10-02', 'SKU-A10', 4, 'Shipped'],
                    ['ORD-1002', 'cust-02', '2026-10-03', 'SKU-B22', 1, 'Processing'],
                    ['ORD-1003', 'CUST-03 ', '2026-10-04', 'SKU-C05', 10, 'Shipped'],
                    ['ORD-1004', 'CUST-04', '2026-10-05', 'SKU-A10', 2, 'Delivered'],
                    ['ORD-1005', 'CUST-99', '2026-10-06', 'SKU-D90', 5, 'Pending'],
                    ['ORD-1006', 'CUST-01', '2026-10-08', 'SKU-B22', 3, 'Delivered'],
                    ['ORD-1007', 'CUST-05', '2026-10-09', 'SKU-E12', 7, 'Shipped']
                ];

                // Sample Secondary File: Customer Directory
                const secondaryData = [
                    ['Customer_ID', 'Customer_Name', 'Account_Tier', 'Region', 'Account_Manager', 'Status'],
                    ['CUST-01', 'Acme Logistics Corp', 'Enterprise', 'North America', 'Priya Sharma', 'Active'],
                    ['CUST-02', 'BlueWave Retail', 'Growth', 'Europe', 'Liam O\'Connor', 'Active'],
                    ['CUST-03', 'Summit Healthcare', 'Enterprise', 'North America', 'Arjun Mehta', 'Active'],
                    ['CUST-04', 'Solstice Energy', 'Mid-Market', 'APAC', 'Elena Rostova', 'Review'],
                    ['CUST-05', 'Vertex Robotics', 'Enterprise', 'APAC', 'Priya Sharma', 'Active']
