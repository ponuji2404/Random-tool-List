                state.file1.workbook = wb1;
                state.file1.fileName = 'Q4_Sales_Orders.xlsx';
                state.file1.sheetNames = wb1.SheetNames;
                state.file1.activeSheet = 'Q4_Orders';
                const p1 = parseSheetData(wb1, 'Q4_Orders');
                state.file1.headers = p1.headers;
                state.file1.rows = p1.rows;

                // Populate state 2
                state.file2.workbook = wb2;
                state.file2.fileName = 'Customer_CRM_Master.xlsx';
                state.file2.sheetNames = wb2.SheetNames;
                state.file2.activeSheet = 'CRM_Accounts';
                const p2 = parseSheetData(wb2, 'CRM_Accounts');
                state.file2.headers = p2.headers;
