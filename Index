<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SheetMerge Pro — Client-Side Excel Merger</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- SheetJS (xlsx) Library via CDN -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        brand: {
                            50: '#ecfdf5',
                            100: '#d1fae5',
                            200: '#a7f3d0',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                            800: '#065f46',
                            900: '#064e3b',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom subtle scrollbar for tables and checklists */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .drop-zone-active {
            border-color: #059669 !important;
            background-color: #ecfdf5 !important;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            animation: fadeIn 0.3s ease-out forwards;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- Top Navigation Bar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="bg-brand-600 text-white p-2 rounded-xl shadow-sm flex items-center justify-center">
                    <!-- Spreadsheet Merge Icon -->
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-lg font-bold text-slate-900 tracking-tight flex items-center gap-2">
                        SheetMerge Pro
                        <span class="text-xs font-medium bg-brand-50 text-brand-700 border border-brand-200 px-2 py-0.5 rounded-full">100% Client-Side</span>
                    </h1>
                    <p class="text-xs text-slate-500 hidden sm:block">Merge & VLOOKUP Excel spreadsheets securely in your browser</p>
                </div>
            </div>

            <div class="flex items-center gap-2 sm:gap-3">
                <button id="loadSampleBtn" type="button" class="inline-flex items-center gap-1.5 px-3 py-2 text-xs sm:text-sm font-medium text-brand-700 bg-brand-50 hover:bg-brand-100 border border-brand-200 rounded-lg transition cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
                    </svg>
                    <span>Load Sample Data</span>
                </button>
                <button id="resetAllBtn" type="button" class="hidden inline-flex items-center gap-1.5 px-3 py-2 text-xs sm:text-sm font-medium text-slate-600 bg-white hover:bg-slate-100 border border-slate-300 rounded-lg transition cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                    <span class="hidden sm:inline">Reset</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Notification Toast Banner (Replaces alert) -->
    <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

    <!-- Main Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

        <!-- Privacy / Security Micro-Banner -->
        <div class="bg-slate-900 text-slate-200 rounded-xl px-4 py-3 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs sm:text-sm shadow-sm">
            <div class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-brand-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
                <span><strong>Zero Server Uploads:</strong> All Excel parsing and merging occurs locally in your browser memory. Your spreadsheets never leave your device.</span>
            </div>
            <span class="text-slate-400 font-mono text-xs shrink-0">Supports .xlsx, .xls, .csv</span>
        </div>

        <!-- STEP 1: FILE UPLOAD SECTION -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/70 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <span class="w-7 h-7 rounded-full bg-brand-600 text-white font-bold text-sm flex items-center justify-center shadow-xs">1</span>
                    <div>
                        <h2 class="text-base font-semibold text-slate-900">Upload Excel Spreadsheets</h2>
                        <p class="text-xs text-slate-500">Select your base spreadsheet and the secondary lookup file containing columns to append.</p>
                    </div>
                </div>
            </div>

            <div class="p-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- PRIMARY FILE UPLOAD CARD -->
                <div class="flex flex-col">
                    <div class="flex items-center justify-between mb-2">
                        <label class="text-sm font-semibold text-slate-800 flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-slate-700"></span>
                            Primary Excel File (Base File)
                        </label>
                        <span class="text-xs text-slate-400 font-medium">Left Table</span>
                    </div>

                    <!-- Dropzone 1 -->
                    <div id="dropZone1" class="relative border-2 border-dashed border-slate-300 rounded-xl p-6 text-center hover:border-brand-500 hover:bg-slate-50/80 transition cursor-pointer flex flex-col items-center justify-center min-h-[175px]">
                        <input type="file" id="fileInput1" accept=".xlsx,.xls,.csv" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" aria-label="Upload Primary Excel File">
                        <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center mb-3">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                            </svg>
                        </div>
                        <p class="text-sm font-medium text-slate-700">Drag & drop your Primary file here, or <span class="text-brand-600 underline">browse</span></p>
                        <p class="text-xs text-slate-400 mt-1">All rows in this file will be preserved by default</p>
                    </div>

                    <!-- Loaded File 1 Metadata Card -->
                    <div id="fileInfo1" class="hidden border border-slate-200 bg-slate-50 rounded-xl p-4 space-y-3 animate-fade-in">
                        <div class="flex items-start justify-between gap-2">
                            <div class="flex items-center gap-3 min-w-0">
                                <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 font-bold text-xs">
                                    XLSX
                                </div>
                                <div class="min-w-0">
                                    <p id="fileName1" class="text-sm font-semibold text-slate-900 truncate">employees_base.xlsx</p>
                                    <p id="fileStats1" class="text-xs text-slate-500 font-mono mt-0.5">0 rows • 0 columns</p>
                                </div>
                            </div>
                            <button type="button" id="replaceFile1Btn" class="text-xs font-medium text-slate-500 hover:text-slate-800 bg-white border border-slate-200 px-2.5 py-1.5 rounded-lg shadow-2xs transition cursor-pointer shrink-0">
                                Change File
                            </button>
                        </div>

                        <!-- Sheet Selector 1 -->
                        <div class="pt-2 border-t border-slate-200/80 flex items-center justify-between gap-3">
                            <label for="sheetSelect1" class="text-xs font-medium text-slate-600 shrink-0">Active Sheet:</label>
                            <select id="sheetSelect1" class="w-full max-w-[240px] text-xs font-medium bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500"></select>
                        </div>
                    </div>
                </div>

                <!-- SECONDARY FILE UPLOAD CARD -->
                <div class="flex flex-col">
                    <div class="flex items-center justify-between mb-2">
                        <label class="text-sm font-semibold text-slate-800 flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-brand-500"></span>
                            Secondary Excel File (Lookup / Source File)
                        </label>
                        <span class="text-xs text-brand-600 font-medium">Right Table</span>
                    </div>

                    <!-- Dropzone 2 -->
                    <div id="dropZone2" class="relative border-2 border-dashed border-slate-300 rounded-xl p-6 text-center hover:border-brand-500 hover:bg-slate-50/80 transition cursor-pointer flex flex-col items-center justify-center min-h-[175px]">
                        <input type="file" id="fileInput2" accept=".xlsx,.xls,.csv" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" aria-label="Upload Secondary Excel File">
                        <div class="w-12 h-12 rounded-full bg-brand-50 text-brand-600 flex items-center justify-center mb-3">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                        </div>
                        <p class="text-sm font-medium text-slate-700">Drag & drop your Secondary file here, or <span class="text-brand-600 underline">browse</span></p>
                        <p class="text-xs text-slate-400 mt-1">Columns from this file will be matched & added to Primary</p>
                    </div>

                    <!-- Loaded File 2 Metadata Card -->
                    <div id="fileInfo2" class="hidden border border-brand-200 bg-brand-50/40 rounded-xl p-4 space-y-3 animate-fade-in">
                        <div class="flex items-start justify-between gap-2">
                            <div class="flex items-center gap-3 min-w-0">
                                <div class="w-10 h-10 rounded-lg bg-brand-600 text-white flex items-center justify-center shrink-0 font-bold text-xs">
                                    XLSX
                                </div>
                                <div class="min-w-0">
                                    <p id="fileName2" class="text-sm font-semibold text-slate-900 truncate">department_details.xlsx</p>
                                    <p id="fileStats2" class="text-xs text-slate-500 font-mono mt-0.5">0 rows • 0 columns</p>
                                </div>
                            </div>
                            <button type="button" id="replaceFile2Btn" class="text-xs font-medium text-slate-600 hover:text-slate-900 bg-white border border-slate-200 px-2.5 py-1.5 rounded-lg shadow-2xs transition cursor-pointer shrink-0">
                                Change File
                            </button>
                        </div>

                        <!-- Sheet Selector 2 -->
                        <div class="pt-2 border-t border-brand-200/60 flex items-center justify-between gap-3">
                            <label for="sheetSelect2" class="text-xs font-medium text-slate-700 shrink-0">Active Sheet:</label>
                            <select id="sheetSelect2" class="w-full max-w-[240px] text-xs font-medium bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500"></select>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- EMPTY STATE PLACEHOLDER WHEN FILES AREN'T BOTH LOADED -->
        <div id="emptyStatePrompt" class="bg-white rounded-2xl border border-dashed border-slate-300 p-10 text-center">
            <div class="max-w-md mx-auto space-y-3">
                <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-400 mx-auto flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-slate-800">Upload both Excel files to configure your merge</h3>
                <p class="text-sm text-slate-500">Once both the Primary and Secondary spreadsheets are loaded, you can choose the matching key columns and select which fields to bring over.</p>
                <div class="pt-2">
                    <button type="button" id="emptyStateSampleBtn" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-brand-700 bg-brand-50 hover:bg-brand-100 border border-brand-200 rounded-xl transition cursor-pointer">
                        Try with Sample Employee & Payroll Sheets
                    </button>
                </div>
            </div>
        </div>

        <!-- STEP 2: MERGE CONFIGURATION SECTION (HIDDEN UNTIL BOTH FILES LOADED) -->
        <section id="step2Section" class="hidden bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden animate-fade-in">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/70 flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-3">
                    <span class="w-7 h-7 rounded-full bg-brand-600 text-white font-bold text-sm flex items-center justify-center shadow-xs">2</span>
                    <div>
                        <h2 class="text-base font-semibold text-slate-900">Configure Match Keys & Columns to Include</h2>
                        <p class="text-xs text-slate-500">Define how rows are matched across both spreadsheets and pick the columns to append.</p>
                    </div>
                </div>
                <span id="autoMatchBadge" class="hidden text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-1 rounded-full">
                    ✨ Auto-detected matching key column
                </span>
            </div>

            <div class="p-6 grid grid-cols-1 lg:grid-cols-12 gap-8">
                <!-- LEFT COLUMN (5 cols): MATCH KEYS & JOIN RULES -->
                <div class="lg:col-span-5 space-y-5">
                    <div class="bg-slate-50 rounded-xl p-5 border border-slate-200/80 space-y-4">
                        <h3 class="text-sm font-semibold text-slate-900 flex items-center gap-2">
                            <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                            </svg>
                            Match Columns (Join Keys)
                        </h3>

                        <!-- Primary Key Selector -->
                        <div>
                            <label for="primaryKeySelect" class="block text-xs font-semibold text-slate-700 mb-1.5">
                                Primary File Key Column
                            </label>
                            <select id="primaryKeySelect" class="w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500"></select>
                        </div>

                        <!-- Visual Connector -->
                        <div class="flex items-center justify-center">
                            <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 bg-white border border-slate-200 px-3 py-1 rounded-full shadow-2xs">
                                <svg class="w-3.5 h-3.5 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                                </svg>
                                Matches With
                            </span>
                        </div>

                        <!-- Secondary Key Selector -->
                        <div>
                            <label for="secondaryKeySelect" class="block text-xs font-semibold text-slate-700 mb-1.5">
                                Secondary File Key Column
                            </label>
                            <select id="secondaryKeySelect" class="w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500"></select>
                        </div>

                        <!-- Matching Options -->
                        <div class="pt-3 border-t border-slate-200 space-y-2.5">
                            <p class="text-xs font-semibold text-slate-700">Matching Behavior</p>
                            <label class="flex items-center gap-2.5 cursor-pointer select-none">
                                <input type="checkbox" id="caseInsensitiveCheck" checked class="w-4 h-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500">
                                <span class="text-xs text-slate-700">Case-insensitive matching <span class="text-slate-400">(e.g., "EMP-01" = "emp-01")</span></span>
                            </label>
                            <label class="flex items-center gap-2.5 cursor-pointer select-none">
                                <input type="checkbox" id="trimWhitespaceCheck" checked class="w-4 h-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500">
                                <span class="text-xs text-slate-700">Trim leading & trailing whitespace</span>
                            </label>
                        </div>
                    </div>

                    <!-- Join Type Selector -->
                    <div class="bg-slate-50 rounded-xl p-5 border border-slate-200/80 space-y-3">
                        <h3 class="text-sm font-semibold text-slate-900">Join Type</h3>
                        <div class="space-y-2.5">
                            <label class="flex items-start gap-3 p-3 bg-white border border-slate-200 rounded-lg cursor-pointer hover:border-brand-400 transition">
                                <input type="radio" name="joinType" value="left" checked class="mt-0.5 w-4 h-4 text-brand-600 border-slate-300 focus:ring-brand-500">
                                <div>
                                    <p class="text-xs font-semibold text-slate-900">Left Join (Recommended)</p>
                                    <p class="text-xs text-slate-500 mt-0.5">Keep all rows from Primary File and add matched columns from Secondary File.</p>
                                </div>
                            </label>
                            <label class="flex items-start gap-3 p-3 bg-white border border-slate-200 rounded-lg cursor-pointer hover:border-brand-400 transition">
                                <input type="radio" name="joinType" value="inner" class="mt-0.5 w-4 h-4 text-brand-600 border-slate-300 focus:ring-brand-500">
                                <div>
                                    <p class="text-xs font-semibold text-slate-900">Inner Join (Exact Matches Only)</p>
                                    <p class="text-xs text-slate-500 mt-0.5">Keep only rows where the key exists in both Primary and Secondary files.</p>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- RIGHT COLUMN (7 cols): COLUMNS TO INCLUDE CHECKLIST -->
                <div class="lg:col-span-7 flex flex-col">
                    <div class="bg-slate-50 rounded-xl p-5 border border-slate-200/80 flex-1 flex flex-col">
                        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                            <div>
                                <h3 class="text-sm font-semibold text-slate-900">Columns to Include from Secondary File</h3>
                                <p class="text-xs text-slate-500">Select which columns will be appended to your Primary spreadsheet.</p>
                            </div>
                            <div class="flex items-center gap-2">
                                <button type="button" id="selectAllColsBtn" class="px-2.5 py-1.5 text-xs font-medium text-brand-700 bg-brand-50 hover:bg-brand-100 border border-brand-200 rounded-lg transition cursor-pointer">
                                    Select All
                                </button>
                                <button type="button" id="deselectAllColsBtn" class="px-2.5 py-1.5 text-xs font-medium text-slate-600 bg-white hover:bg-slate-100 border border-slate-300 rounded-lg transition cursor-pointer">
                                    Deselect All
                                </button>
                            </div>
                        </div>

                        <!-- Search Filter & Counter -->
                        <div class="flex items-center gap-3 mb-3">
                            <div class="relative flex-1">
                                <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                                <input type="text" id="colSearchInput" placeholder="Filter secondary columns..." class="w-full pl-9 pr-3 py-2 text-xs bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500">
                            </div>
                            <span id="selectedColsCountBadge" class="text-xs font-semibold text-slate-700 bg-white border border-slate-200 px-3 py-2 rounded-lg shrink-0">
                                0 selected
                            </span>
                        </div>

                        <!-- Scrollable Column Checklist -->
                        <div id="secondaryColsChecklist" class="bg-white border border-slate-200 rounded-xl divide-y divide-slate-100 overflow-y-auto max-h-[320px] flex-1">
                            <!-- Dynamically populated checkboxes -->
                        </div>

                        <!-- Duplicate Name Info Note -->
                        <div id="renameNotice" class="hidden mt-3 flex items-center gap-2 text-xs text-amber-800 bg-amber-50 border border-amber-200 px-3 py-2 rounded-lg">
                            <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <span>Columns marked with <strong class="font-mono">_merged</strong> already exist in your Primary file and will be automatically renamed to prevent overwriting.</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

